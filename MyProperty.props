<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <dds>Resources/Images/</dds>
    <cmo>Resources/Models/</cmo>
    <cso>Resources/Shaders/</cso>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <ImageContentTask>
      <ContentOutput>$(dds)%(Filename).dds</ContentOutput>
      <GeneratePremultipliedAlpha>true</GeneratePremultipliedAlpha>
      <Compress>BC7_UNORM_SRGB</Compress>
    </ImageContentTask>
    <MeshContentTask>
      <ContentOutput>$(cmo)%(Filename).cmo</ContentOutput>
    </MeshContentTask>
    <Link>
      <AdditionalDependencies>$(CoreLibraryDependencies);%(AdditionalDependencies);d3d11.lib;dxgi.lib;d2d1.lib;Dwrite.lib</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
    </Link>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)</AdditionalIncludeDirectories>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>Pch.h</PrecompiledHeaderFile>
      <ForcedIncludeFiles>
      </ForcedIncludeFiles>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Manifest>
      <EnableDpiAwareness>PerMonitorHighDPIAware</EnableDpiAwareness>
    </Manifest>
    <ShaderGraphContentTask />
    <FxCompile>
      <ObjectFileOutput>$(cso)%(Filename).cso</ObjectFileOutput>
      <ShaderModel>5.0</ShaderModel>
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="dds">
      <Value>$(dds)</Value>
    </BuildMacro>
    <BuildMacro Include="cmo">
      <Value>$(cmo)</Value>
    </BuildMacro>
    <BuildMacro Include="cso">
      <Value>$(cso)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>